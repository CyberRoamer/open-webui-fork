# ==============================================================================
# Open WebUI Portable Deployment — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the parameters for your target environment.
# Zero production credentials or internal gateway IP addresses should be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LiteLLM Proxy Ingress Configuration (REQUIRED)
# ------------------------------------------------------------------------------
# Base URL of your existing LiteLLM proxy instance.
# Examples:
#   - Local container / same host: http://host.docker.internal:4000
#   - Remote internal server:      http://192.168.1.50:4000
#   - Remote HTTPS reverse proxy:  https://litellm.example.com
LITELLM_BASE_URL=http://<YOUR_LITELLM_HOST>:4000

# LiteLLM Master Key or User Virtual Key for authentication.
# Open WebUI uses this single key for text, images, audio, and speech coaching.
LITELLM_API_KEY=<YOUR_LITELLM_API_KEY>

# ------------------------------------------------------------------------------
# 2. Text & Chat Model Configuration
# ------------------------------------------------------------------------------
# Open WebUI OpenAI-compatible chat API endpoint.
# Default: ${LITELLM_BASE_URL}/v1
OPENAI_API_BASE_URL=${LITELLM_BASE_URL}/v1
OPENAI_API_KEY=${LITELLM_API_KEY}

# ------------------------------------------------------------------------------
# 3. Image Generation & Model Discovery Configuration
# ------------------------------------------------------------------------------
# Dedicated image model discovery and generation endpoint.
# LiteLLM isolates image models under /images/v1 to prevent chat model selector pollution.
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=openai
IMAGES_OPENAI_API_BASE_URL=${LITELLM_BASE_URL}/images/v1
IMAGES_OPENAI_API_KEY=${LITELLM_API_KEY}
IMAGE_URL_RESPONSE_MODELS_REGEX_PATTERN=.*
IMAGE_GENERATION_MODEL=flux1-schnell
ENABLE_IMAGE_EDIT=true
IMAGE_EDIT_ENGINE=openai
IMAGE_EDIT_MODEL=flux1-schnell

# ------------------------------------------------------------------------------
# 4. Turn-Based Audio STT (Speech-to-Text) Configuration
# ------------------------------------------------------------------------------
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=${LITELLM_BASE_URL}/v1
AUDIO_STT_OPENAI_API_KEY=${LITELLM_API_KEY}
AUDIO_STT_MODEL=whisper-1

# ------------------------------------------------------------------------------
# 5. Turn-Based Audio TTS (Text-to-Speech) Configuration
# ------------------------------------------------------------------------------
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=${LITELLM_BASE_URL}/v1
AUDIO_TTS_OPENAI_API_KEY=${LITELLM_API_KEY}
AUDIO_TTS_MODEL=tts-1
AUDIO_TTS_VOICE=alloy

# ------------------------------------------------------------------------------
# 6. Realtime Voice Call Subsystem Configuration
# ------------------------------------------------------------------------------
AUDIO_REALTIME_ENABLED=true
AUDIO_REALTIME_PROVIDER=openai
AUDIO_REALTIME_AUTH_TYPE=api_key
AUDIO_REALTIME_OPENAI_API_BASE_URL=${LITELLM_BASE_URL}/v1
AUDIO_REALTIME_OPENAI_API_KEY=${LITELLM_API_KEY}
AUDIO_REALTIME_MODEL=realtime-voice
AUDIO_REALTIME_VOICE=en_US-lessac-medium
AUDIO_REALTIME_TRANSCRIPTION_MODEL=whisper-1

# ------------------------------------------------------------------------------
# 7. Speech Coach Tool Valves Configuration
# ------------------------------------------------------------------------------
# Endpoint paths routed through the LiteLLM proxy to AI Gateway
SPEECH_COACH_ANALYSIS_PATH=/v1/audio/speech-analysis
SPEECH_COACH_VOICES_PATH=/v1/audio/voices
SPEECH_COACH_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# 8. WebUI Instance & Host Settings
# ------------------------------------------------------------------------------
# Host port on which Open WebUI will listen
PORT=3000

# Name displayed in the WebUI header
WEBUI_NAME=Open WebUI

# Persistent data directory on host
OPEN_WEBUI_DATA_DIR=./data

# Container and project names
CONTAINER_NAME=open-webui

# Telemetry and privacy
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
SCARF_NO_ANALYTICS=true
