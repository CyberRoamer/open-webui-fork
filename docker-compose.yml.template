services:
  open-webui:
    image: ghcr.io/open-webui/open-webui:v0.13.4
    container_name: ${CONTAINER_NAME:-open-webui}
    restart: unless-stopped
    entrypoint: ["/bin/bash", "/opt/realtime-patch/entrypoint.sh"]
    ports:
      - "${PORT:-3000}:8080"
    environment:
      - PORT=8080
      - WEBUI_NAME=${WEBUI_NAME:-Open WebUI}
      - OPENAI_API_BASE_URL=${OPENAI_API_BASE_URL}
      - OPENAI_API_KEY=${OPENAI_API_KEY}
      - LITELLM_BASE_URL=${LITELLM_BASE_URL}
      - LITELLM_MASTER_KEY=${LITELLM_API_KEY}
      - ENABLE_IMAGE_GENERATION=${ENABLE_IMAGE_GENERATION:-true}
      - IMAGE_GENERATION_ENGINE=${IMAGE_GENERATION_ENGINE:-openai}
      - IMAGE_GENERATION_MODEL=${IMAGE_GENERATION_MODEL:-flux1-schnell}
      - IMAGES_OPENAI_API_BASE_URL=${IMAGES_OPENAI_API_BASE_URL}
      - IMAGES_OPENAI_API_KEY=${IMAGES_OPENAI_API_KEY}
      - IMAGE_URL_RESPONSE_MODELS_REGEX_PATTERN=${IMAGE_URL_RESPONSE_MODELS_REGEX_PATTERN:-.*}
      - ENABLE_IMAGE_EDIT=${ENABLE_IMAGE_EDIT:-true}
      - IMAGE_EDIT_ENGINE=${IMAGE_EDIT_ENGINE:-openai}
      - IMAGES_EDIT_OPENAI_API_BASE_URL=${IMAGES_EDIT_OPENAI_API_BASE_URL:-${LITELLM_BASE_URL}/images/v1}
      - IMAGES_EDIT_OPENAI_API_KEY=${IMAGES_EDIT_OPENAI_API_KEY:-${LITELLM_API_KEY}}
      - IMAGE_EDIT_MODEL=${IMAGE_EDIT_MODEL:-flux1-schnell}
      - AUDIO_STT_ENGINE=${AUDIO_STT_ENGINE:-openai}
      - AUDIO_STT_OPENAI_API_BASE_URL=${AUDIO_STT_OPENAI_API_BASE_URL}
      - AUDIO_STT_OPENAI_API_KEY=${AUDIO_STT_OPENAI_API_KEY}
      - AUDIO_STT_MODEL=${AUDIO_STT_MODEL:-whisper-1}
      - AUDIO_TTS_ENGINE=${AUDIO_TTS_ENGINE:-openai}
      - AUDIO_TTS_OPENAI_API_BASE_URL=${AUDIO_TTS_OPENAI_API_BASE_URL}
      - AUDIO_TTS_OPENAI_API_KEY=${AUDIO_TTS_OPENAI_API_KEY}
      - AUDIO_TTS_MODEL=${AUDIO_TTS_MODEL:-tts-1}
      - AUDIO_TTS_VOICE=${AUDIO_TTS_VOICE:-alloy}
      - AUDIO_REALTIME_ENABLED=${AUDIO_REALTIME_ENABLED:-true}
      - AUDIO_REALTIME_PROVIDER=${AUDIO_REALTIME_PROVIDER:-openai}
      - AUDIO_REALTIME_AUTH_TYPE=${AUDIO_REALTIME_AUTH_TYPE:-api_key}
      - AUDIO_REALTIME_OPENAI_API_BASE_URL=${AUDIO_REALTIME_OPENAI_API_BASE_URL}
      - AUDIO_REALTIME_OPENAI_API_KEY=${AUDIO_REALTIME_OPENAI_API_KEY}
      - AUDIO_REALTIME_MODEL=${AUDIO_REALTIME_MODEL:-realtime-voice}
      - AUDIO_REALTIME_VOICE=${AUDIO_REALTIME_VOICE:-en_US-lessac-medium}
      - AUDIO_REALTIME_TRANSCRIPTION_MODEL=${AUDIO_REALTIME_TRANSCRIPTION_MODEL:-whisper-1}
      - DO_NOT_TRACK=${DO_NOT_TRACK:-true}
      - ANONYMIZED_TELEMETRY=${ANONYMIZED_TELEMETRY:-false}
      - SCARF_NO_ANALYTICS=${SCARF_NO_ANALYTICS:-true}
    volumes:
      - ${OPEN_WEBUI_DATA_DIR:-./data}:/app/backend/data
      - ./patches/v0.13.4/BnHPywC-.js:/opt/realtime-patch/BnHPywC-.js:ro
      - ./patches/v0.13.4/openwebui_realtime_entrypoint.sh:/opt/realtime-patch/entrypoint.sh:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    healthcheck:
      test: ["CMD-SHELL", "curl -s -f http://localhost:8080/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
